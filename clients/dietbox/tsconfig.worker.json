{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "worker",
    "product.config.ts",
    "integrations/**/*.ts",
    "worker-configuration.d.ts",
    "shared"
  ]
}
